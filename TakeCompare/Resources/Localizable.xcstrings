          "stringUnit": {
            "state": "translated",
            "value": "Loop off"
          }
        }
      }
    },
    "루프 켬": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop on"
          }
        }
