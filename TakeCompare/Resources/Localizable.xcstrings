          }
        }
      }
    },
    "오프셋 %@f": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "offset %@f"
          }
        }
      }
    },
    "이 테이크 In/Out 초기화 (⌥I · ⌥O)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear this take's In/Out (⌥I · ⌥O)"
          }
        }
      }
    },
    "이 테이크 In으로 (In이 없으면 처음)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to this take’s In (or the start)"
          }
        }
      }
    },
    "이 테이크 Out으로 (Out이 없으면 끝)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to this take’s Out (or the end)"
          }
        }
      }
    },
    "이 테이크 소리 켜기 (하나만)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play audio from this take (one at a time)"
          }
        }
      }
    },
    "이 테이크 위치만 1초 뒤로 (⌥⇧←)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move only this take back 1 second (⌥⇧←)"
          }
        }
      }
    },
    "이 테이크 위치만 1초 앞으로 (⌥⇧→)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move only this take forward 1 second (⌥⇧→)"
          }
        }
      }
    },
    "이 테이크 위치만 1프레임 뒤로 — 길게 누르면 반복 (⌥←)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move only this take back 1 frame — hold to repeat (⌥←)"
          }
        }
      }
    },
    "이 테이크 위치만 1프레임 앞으로 — 길게 누르면 반복 (⌥→)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move only this take forward 1 frame — hold to repeat (⌥→)"
          }
        }
      }
    },
    "이 테이크가 지금 보여주는 프레임을 In으로 (I) — 공통 재생은 각자 In부터 같이 간다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set In to the frame this take is showing (I) — shared playback starts every take from its In"
          }
        }
      }
    },
    "이 테이크가 지금 보여주는 프레임을 Out으로 (O)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Out to the frame this take is showing (O)"
          }
        }
      }
    },
    "이 테이크만 재생/정지": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play/pause this take only"
