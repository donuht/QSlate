        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparing needs 2 or more — drop 2–4 videos at once"
          }
        }
      }
    },
    "비교할 테이크 2~4개를 고르세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose 2–4 takes to compare"
          }
        }
      }
    },
    "비교할 테이크를 끌어다 놓으세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop the takes to compare"
          }
