    "루프": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop"
          }
        }
      }
    },
    "루프 (L)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop (L)"
          }
        }
      }
    },
    "루프 끔": {
      "localizations": {
