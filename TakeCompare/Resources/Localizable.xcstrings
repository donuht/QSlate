            "state": "translated",
            "value": "Forward 1 Frame"
          }
        }
      }
    },
    "확대/축소": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoom"
          }
        }
      }
    }
  },
  "version": "1.0"
}
