    "끝으로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to End"
          }
        }
      }
    },
    "단독 보기 — 같은 숫자 또는 Esc로 격자": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo view — press the same number or Esc for the grid"
          }
        }
      }
