{
  "sourceLanguage": "ko",
  "strings": {
    "%lld개 중 %lld개를 열지 못했습니다 — 나머지로 비교합니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open %2$lld of %1$lld — comparing the rest"
          }
        }
      }
    },
    "%lld개 중 앞의 4개만 열었습니다 — 5번째부터는 무시했습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened only the first 4 of %lld — the 5th and later were ignored"
          }
        }
      }
    },
    "%lld장 저장 → %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved %lld frames → %@"
          }
        }
      }
    },
    "%lld장 저장, %lld장 실패 → %@ (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved %1$lld, %2$lld failed → %3$@ (%4$@)"
          }
        }
      }
    },
    "1초 뒤로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back 1 Second"
          }
        }
      }
    },
    "1초 앞으로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forward 1 Second"
          }
        }
      }
    },
    "Finder에서 보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Finder"
          }
        }
      }
    },
    "In 기준 시각 / 범위(가장 긴 In~Out)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time from In / range (longest In–Out)"
          }
        }
      }
    },
    "In 설정 (선택한 테이크)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set In (Selected Take)"
          }
        }
      }
    },
    "In 초기화 (선택한 테이크)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear In (Selected Take)"
