    "길이를 읽을 수 없습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the duration"
          }
        }
      }
    },
    "끌어서 이 테이크 위치만 이동 (In/Out은 그대로)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move only this take (In/Out stay put)"
