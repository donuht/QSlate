        }
      }
    },
    "Out 설정 (선택한 테이크)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Out (Selected Take)"
          }
        }
      }
    },
    "Out 초기화 (선택한 테이크)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Out (Selected Take)"
          }
        }
      }
    },
    "Out(%@)보다 뒤라 Out을 지웠습니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "at or after the Out (%@), so the Out was cleared"
          }
        }
      }
    },
    "Out이 In(%@)보다 앞이라 무시했습니다 — 테이크 %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Out is before In (%1$@), ignored — take %2$lld"
          }
        }
      }
    },
    "PNG 파일을 만들 수 없습니다: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create PNG file: %@"
          }
        }
      }
    },
    "TakeCompare 가리기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide TakeCompare"
          }
        }
      }
    },
    "TakeCompare 종료": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit TakeCompare"
          }
        }
      }
    },
    "TakeCompare에 관하여": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About TakeCompare"
          }
        }
      }
    },
    "mp4·mov 2~4개 · ⌘O로 열기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2–4 mp4/mov files · ⌘O to open"
          }
        }
      }
    },
    "mp4·mov 2~4개를 창에 끌어다 놓거나 ⌘O로 여세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop 2–4 mp4/mov files on the window, or press ⌘O"
          }
        }
      }
    },
    "격자": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grid"
          }
        }
      }
    },
    "격자로 돌아가기 (%lld 또는 Esc)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to the grid (%lld or Esc)"
