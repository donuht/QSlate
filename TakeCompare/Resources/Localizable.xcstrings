          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        }
      }
    },
    "프레임 저장 (모든 테이크)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save Frames (All Takes)"
